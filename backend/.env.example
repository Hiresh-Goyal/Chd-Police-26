# DigitalSentinel Backend — Environment Variables
# Copy to .env and fill in your values.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_sentinel

# JWT secret for API auth (Member 4 uses this)
JWT_SECRET=digitalsentinel_hackathon_secret_2026

# Directory for raw evidence file storage
EVIDENCE_DIR=./data/evidence
